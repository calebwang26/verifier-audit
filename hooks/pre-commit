#!/bin/sh
# Blocks the commit if gitleaks finds a secret in the staged changes.
# Installed by scripts/install_hooks.sh (sets core.hooksPath to hooks/).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit blocked." >&2
  exit 1
fi
exec gitleaks protect --staged --redact --config .gitleaks.toml
